# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na Vercel
# (Settings › Environment Variables). Nunca coloque valores reais neste arquivo.

# Supabase › Project Settings › Data API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase › API Keys › service_role — SÓ servidor. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Domínio público, sem barra no fim. Assina canonical, sitemap, Open Graph e
# os links dos XMLs dos portais.
NEXT_PUBLIC_SITE_URL=https://valedosolimoveis.com.br

# 1 = pede aos buscadores para não indexar (versão de aprovação).
# Em produção, no domínio oficial, APAGUE esta variável.
# NEXT_PUBLIC_NOINDEX=1
